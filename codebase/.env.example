APP_NAME=PromptOpt API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,https://vinaip002.web.app

# Local: dev-token + in-memory metadata + local ZIP storage
AUTH_MODE=disabled
REPOSITORY_BACKEND=memory
STORAGE_BACKEND=local
ANALYSIS_DISPATCHER=inline
LOCAL_UPLOAD_DIR=./data/uploads

# Google Cloud
GCP_PROJECT_ID=vinaip002
GCP_SERVICE_ACCOUNT_EMAIL=
GCS_BUCKET=
CLOUD_TASKS_LOCATION=asia-southeast1
CLOUD_TASKS_QUEUE=promptopt-analysis
ANALYSIS_WORKER_URL=
ANALYSIS_TASK_AUDIENCE=
BASELINE_DISPATCHER=inline
BASELINE_EXECUTION_BACKEND=disabled
BASELINE_CLOUD_TASKS_QUEUE=promptopt-baseline
BASELINE_WORKER_URL=
BASELINE_TASK_AUDIENCE=
BASELINE_RUNNER_IMAGE=promptopt-coverup-runner:local
CLOUD_RUN_RUNNER_JOB=promptopt-coverup-runner
CLOUD_RUN_RUNNER_TIMEOUT_SECONDS=900
MAX_ANALYSIS_PYTHON_FILES=5000
MAX_ANALYSIS_UNCOMPRESSED_BYTES=52428800
SIGNED_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=104857600

# Production requires:
# APP_ENV=production
# AUTH_MODE=firebase
# REPOSITORY_BACKEND=firestore
# STORAGE_BACKEND=gcs
# ANALYSIS_DISPATCHER=cloud_tasks
# GCP_SERVICE_ACCOUNT_EMAIL=promptopt-api@vinaip002.iam.gserviceaccount.com
# GCS_BUCKET=<private-source-bucket>
# ANALYSIS_WORKER_URL=<direct-cloud-run-url>
# ANALYSIS_TASK_AUDIENCE=<direct-cloud-run-url>
# BASELINE_DISPATCHER=cloud_tasks
# BASELINE_EXECUTION_BACKEND=cloud_run_job
# BASELINE_WORKER_URL=<direct-cloud-run-url>
# BASELINE_TASK_AUDIENCE=<direct-cloud-run-url>
