FROM python:3.12-slim

WORKDIR /app
RUN python -m pip install --no-cache-dir \
    "google-api-core[grpc]>=2.25.0,<2.35.0" \
    "google-auth>=2.38,<3" \
    "google-cloud-storage>=2.19,<4" \
    "requests>=2.32,<3"

COPY cloud/runtime_image_factory.py ./cloud/runtime_image_factory.py
RUN useradd --create-home appuser && chown -R appuser:appuser /app

ENV PYTHONPATH=/app
USER appuser
CMD ["python", "-m", "cloud.runtime_image_factory", "--help"]
