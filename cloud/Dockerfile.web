FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.9.13 /uv /uvx /bin/
WORKDIR /app
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --python /usr/local/bin/python3.12

FROM python:3.12-slim

WORKDIR /app
COPY --from=builder /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app/src"

RUN useradd --create-home appuser
COPY src/coverup ./src/coverup
COPY src/optimization ./src/optimization
COPY src/sample_repo ./sample_repo
COPY cloud/run_job.py ./cloud/run_job.py
RUN test -d /app/sample_repo/isort/isort \
    && test -d /app/sample_repo/mlxtend/mlxtend \
    && test -d /app/sample_repo/typesystem/typesystem \
    && mkdir -p /app/artifacts \
    && chown -R appuser:appuser /app

USER appuser
CMD ["python", "-m", "cloud.run_job", "--help"]
