# CoverUp/GEPA CLI and Cloud Run Job model configuration.
# Copy to .env only when intentionally running a live model evaluation.
# Never commit .env, credentials, tokens, or raw production output.

COVERUP_MODEL=vertex_ai/gemini-3.6-flash
OPTIMIZE_MODEL=vertex_ai/gemini-3.6-flash
VERTEXAI_PROJECT=your-vertex-ai-project
VERTEXAI_LOCATION=global

# Optional telemetry. Leave unset for local tests.
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=promptopt
# LANGCHAIN_TRACING_V2=true

# Optional course AI-usage logger. Obtain the key from the project owner.
# AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
# AI_LOG_API_KEY=
# AI_LOG_DIR=.ai-log
