# Connected mode uses Firebase Authentication and the real PromptOpt API.
# For local development, Vite proxies /api to the production Cloud Run API.
VITE_AUTH_MODE=firebase
VITE_DATA_MODE=connected
VITE_API_BASE_URL=/api/v1

# Required when VITE_AUTH_MODE=firebase. These are public Firebase Web App identifiers.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=project-7df9f963-9fe0-4b76-b3d.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=project-7df9f963-9fe0-4b76-b3d
VITE_FIREBASE_STORAGE_BUCKET=project-7df9f963-9fe0-4b76-b3d.firebasestorage.app
VITE_FIREBASE_APP_ID=1:861862240028:web:25b6f12238bce0664be4d9
