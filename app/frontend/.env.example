# Connected mode uses Firebase Authentication and the real PromptOpt API.
# For local development, Vite proxies /api to the production Cloud Run API.
VITE_AUTH_MODE=firebase
VITE_DATA_MODE=connected
VITE_API_BASE_URL=/api/v1

# Required when VITE_AUTH_MODE=firebase. These are public Firebase Web App identifiers.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=vinai-505107.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vinai-505107
VITE_FIREBASE_STORAGE_BUCKET=vinai-505107.firebasestorage.app
VITE_FIREBASE_APP_ID=1:509384558275:web:748a06848ce29067a3c476
