# Full local development: demo login + real local API.
VITE_AUTH_MODE=demo
VITE_DATA_MODE=connected
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# For Firebase-connected mode, set VITE_AUTH_MODE=firebase and fill these public
# Firebase Web App identifiers. Never put a service-account key in Vite env.
# VITE_FIREBASE_API_KEY=your-firebase-web-api-key
# VITE_FIREBASE_AUTH_DOMAIN=project-7df9f963-9fe0-4b76-b3d.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=project-7df9f963-9fe0-4b76-b3d
# VITE_FIREBASE_STORAGE_BUCKET=project-7df9f963-9fe0-4b76-b3d.firebasestorage.app
# VITE_FIREBASE_APP_ID=your-firebase-web-app-id
