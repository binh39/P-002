# FastAPI local-safe profile. Copy to app/.env.
APP_NAME=PromptOpt API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local requests still require: Authorization: Bearer dev-token
AUTH_MODE=disabled
REPOSITORY_BACKEND=memory
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./data/uploads

# Local analysis runs inside the API process.
ANALYSIS_DISPATCHER=inline
MAX_ANALYSIS_PYTHON_FILES=5000
MAX_ANALYSIS_UNCOMPRESSED_BYTES=52428800
MAX_UPLOAD_BYTES=104857600
SIGNED_URL_TTL_SECONDS=900
SAMPLE_REPOS_DIR=../src/sample_repo

# Local experiment lifecycle is inline, but live GEPA execution remains disabled.
EXPERIMENT_DISPATCHER=inline
OPTIMIZATION_EXECUTION_BACKEND=inline
OPTIMIZE_MODEL=
OPTIMIZE_MODEL_ALLOWLIST=vertex_ai/gemini-3.1-pro-preview
GEPA_MAX_METRIC_CALLS=30
GEPA_MAX_CONCURRENCY=10
GEPA_REPEAT_TESTS=5
GEPA_EVALUATION_REPLICATES=1
FINAL_EVALUATION_REPLICATES=2

# Google Cloud values are inactive in the local-safe profile above.
GCP_PROJECT_ID=project-7df9f963-9fe0-4b76-b3d
ADMIN_VERTEXAI_PROJECT=vinbuildphase
GCP_SERVICE_ACCOUNT_EMAIL=
GCS_BUCKET=
CLOUD_TASKS_LOCATION=asia-southeast1
CLOUD_TASKS_QUEUE=promptopt-analysis
ANALYSIS_WORKER_URL=
ANALYSIS_TASK_AUDIENCE=
EXPERIMENT_CLOUD_TASKS_QUEUE=promptopt-baseline
EXPERIMENT_WORKER_URL=
EXPERIMENT_TASK_AUDIENCE=
CLOUD_RUN_GEPA_JOB=promptopt-gepa-runner
CLOUD_RUN_GEPA_TIMEOUT_SECONDS=86400
RUNTIME_EXECUTION_BACKEND=disabled
CLOUD_RUN_RUNTIME_JOB=promptopt-runtime-preparer
CLOUD_RUN_RUNTIME_TIMEOUT_SECONDS=1800

# Production must override at least:
# APP_ENV=production
# AUTH_MODE=firebase
# REPOSITORY_BACKEND=firestore
# STORAGE_BACKEND=gcs
# ANALYSIS_DISPATCHER=cloud_tasks
# EXPERIMENT_DISPATCHER=cloud_tasks
# OPTIMIZATION_EXECUTION_BACKEND=cloud_run_job
# RUNTIME_EXECUTION_BACKEND=cloud_run_job
# GCP_SERVICE_ACCOUNT_EMAIL=promptopt-api@<gcp-project>.iam.gserviceaccount.com
# GCS_BUCKET=<private-artifact-bucket>
# ANALYSIS_WORKER_URL=<direct-cloud-run-api-url>
# ANALYSIS_TASK_AUDIENCE=<same-direct-cloud-run-api-url>
# EXPERIMENT_WORKER_URL=<direct-cloud-run-api-url>
# EXPERIMENT_TASK_AUDIENCE=<same-direct-cloud-run-api-url>
